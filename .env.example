# SPEC NEXA Environment Configuration
# Copy this file to .env and insert your real keys

# Supabase (Optional: Local fallback dataset works automatically without Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini API (Optional: Intelligent rule-based fallback active without API key)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# App URL
VITE_APP_URL=http://localhost:3000
